{
  "name": "open-prototype",
  "version": "0.1.0",
  "private": true,
  "license": "Apache-2.0",
  "homepage": "https://github.com/thaithienvanid/open-prototype",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thaithienvanid/open-prototype.git"
  },
  "bugs": {
    "url": "https://github.com/thaithienvanid/open-prototype/issues"
  },
  "type": "module",
  "description": "Design UI prototypes as plain HTML, from a first draft to a reviewed design ready to build.",
  "bin": {
    "open-prototype": "src/cli.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./server": "./opencode/server.ts"
  },
  "files": [
    "src",
    "assets",
    "schemas",
    "skills",
    "bin",
    "opencode"
  ],
  "scripts": {
    "check": "bun tools/check.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "lint": "biome lint",
    "format": "biome check --write --linter-enabled=false",
    "build:viewer": "bun tools/build-viewer.ts",
    "compile": "bun build --compile src/cli.ts --outfile dist/open-prototype"
  },
  "engines": {
    "bun": ">=1.4.4"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@types/bun": "1.4.4",
    "typescript": "7.0.2"
  }
}
